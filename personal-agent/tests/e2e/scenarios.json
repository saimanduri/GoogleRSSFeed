{
 "about": "Every UI action with its backend call, expected response and expected backend side effects (security-log events). Run: python scripts/e2e_runner.py. UI-side expectations are in ui_actions.json.",
 "steps": [
  {
   "id": "meta.about",
   "ui": "Settings > Diagnostics & About",
   "call": "about",
   "expect": {
    "has": [
     "version"
    ]
   }
  },
  {
   "id": "meta.status_fresh",
   "ui": "App start (no account)",
   "call": "session.status",
   "expect": {
    "eq": {
     "state": "SETUP_REQUIRED"
    }
   }
  },
  {
   "id": "setup.preflight",
   "ui": "Wizard step 1 (checks)",
   "call": "setup.preflight",
   "expect": {
    "has": [
     "tpm"
    ]
   }
  },
  {
   "id": "setup.weak_password",
   "ui": "Wizard: type a weak password (strength meter)",
   "call": "setup.check_password",
   "params": {
    "password": "password123",
    "username": "tester9"
   },
   "expect": {
    "truthy": [
     "errors"
    ]
   }
  },
  {
   "id": "setup.strong_password",
   "ui": "Wizard: strong password enables Continue",
   "call": "setup.check_password",
   "params": {
    "password": "${PASSWORD}",
    "username": "tester9"
   },
   "expect": {
    "falsy": [
     "errors"
    ]
   }
  },
  {
   "id": "setup.trivial_pin",
   "ui": "Wizard: PIN 123456 is refused",
   "call": "setup.check_pin",
   "params": {
    "pin": "123456"
   },
   "expect": {
    "truthy": [
     "errors"
    ]
   }
  },
  {
   "id": "setup.good_pin",
   "ui": "Wizard: good PIN accepted",
   "call": "setup.check_pin",
   "params": {
    "pin": "${PIN}"
   },
   "expect": {
    "falsy": [
     "errors"
    ]
   }
  },
  {
   "id": "setup.create",
   "ui": "Wizard: Create account",
   "call": "setup.create",
   "hook": "recovery_answers",
   "params": {
    "username": "tester9",
    "password": "${PASSWORD}",
    "pin": "${PIN}",
    "display_name": "E2E Tester",
    "assistant_name": "Probe"
   },
   "expect": {
    "has": [
     "recovery_key",
     "confirm_groups"
    ]
   },
   "audit": [
    "setup.completed"
   ]
  },
  {
   "id": "setup.recovery_pdf",
   "ui": "Wizard: Save recovery key as PDF",
   "call": "setup.recovery_pdf",
   "params": {
    "path": "${TMP}/rk.pdf"
   },
   "expect": {
    "file_exists": [
     "${TMP}/rk.pdf"
    ]
   },
   "audit": [
    "recovery_key.saved_to_file"
   ]
  },
  {
   "id": "setup.confirm_wrong",
   "ui": "Wizard: wrong recovery groups are refused",
   "call": "setup.confirm_recovery",
   "params": {
    "answers": {
     "0": "AAAAA",
     "1": "BBBBB"
    }
   },
   "expect": {
    "error_code": "recovery_mismatch"
   }
  },
  {
   "id": "setup.confirm_recovery",
   "ui": "Wizard: type back 2 groups",
   "call": "setup.confirm_recovery",
   "params": {
    "answers": "${RK_ANSWERS}"
   },
   "expect": {
    "eq": {
     "ok": true
    }
   },
   "audit": [
    "recovery_key.confirmed"
   ]
  },
  {
   "id": "meta.status_unlocked",
   "ui": "Home after setup",
   "call": "session.status",
   "expect": {
    "eq": {
     "state": "UNLOCKED",
     "display_name": "E2E Tester",
     "assistant_name": "Probe"
    }
   }
  },
  {
   "id": "meta.touch",
   "ui": "Any click/keypress (idle timer)",
   "call": "session.touch"
  },
  {
   "id": "auth.lock",
   "ui": "Top bar: Lock",
   "call": "auth.lock",
   "audit": [
    "auth.locked"
   ]
  },
  {
   "id": "auth.locked_blocks",
   "ui": "Locked: other screens refuse",
   "call": "chat.list",
   "expect": {
    "error_code": "locked"
   }
  },
  {
   "id": "auth.quick_unlock",
   "ui": "Lock screen: PIN + Unlock",
   "call": "auth.quick_unlock",
   "params": {
    "pin": "${PIN}"
   },
   "audit": [
    "auth.quick_unlock"
   ]
  },
  {
   "id": "auth.sign_out",
   "ui": "Sign out (cold start state)",
   "call": "auth.sign_out",
   "audit": [
    "auth.signout"
   ]
  },
  {
   "id": "auth.sign_in_wrong",
   "ui": "Sign-in: wrong password",
   "call": "auth.sign_in",
   "params": {
    "username": "tester9",
    "password": "Wrong-Password-1234!"
   },
   "expect": {
    "error_code": "auth_failed"
   },
   "audit": [
    "auth.signin_failed"
   ]
  },
  {
   "id": "auth.sign_in",
   "ui": "Sign-in: username + password",
   "call": "auth.sign_in",
   "params": {
    "username": "tester9",
    "password": "${PASSWORD}"
   },
   "audit": [
    "auth.signin"
   ]
  },
  {
   "id": "auth.stepup_password",
   "ui": "Re-auth dialog: password",
   "call": "auth.step_up",
   "params": {
    "category": "secrets",
    "method": "password",
    "secret": "${PASSWORD}"
   },
   "audit": [
    "auth.stepup"
   ]
  },
  {
   "id": "auth.stepup_pin",
   "ui": "Re-auth dialog: PIN",
   "call": "auth.step_up",
   "params": {
    "category": "export",
    "method": "pin",
    "secret": "${PIN}"
   }
  },
  {
   "id": "account.profile",
   "ui": "Settings > Account > Profile > Save",
   "call": "account.set_profile",
   "params": {
    "display_name": "Renamed",
    "assistant_name": "Probe2"
   },
   "audit": [
    "profile.changed"
   ]
  },
  {
   "id": "account.profile_check",
   "ui": "Sidebar/title show new names",
   "call": "session.status",
   "expect": {
    "eq": {
     "display_name": "Renamed",
     "assistant_name": "Probe2"
    }
   }
  },
  {
   "id": "account.username",
   "ui": "Settings > Account > Change username",
   "call": "account.change_username",
   "params": {
    "password": "${PASSWORD}",
    "username": "tester10"
   },
   "audit": [
    "auth.username_changed"
   ]
  },
  {
   "id": "account.signin_history",
   "ui": "Settings > Account > Sign-in history",
   "call": "account.signin_history",
   "expect": {
    "len_ge": {
     "$len": 1
    }
   }
  },
  {
   "id": "account.change_password",
   "ui": "Settings > Account > Password > Change",
   "call": "account.change_password",
   "params": {
    "current": "${PASSWORD}",
    "new": "${PW2}"
   },
   "set": {
    "PASSWORD": "${PW2}"
   },
   "audit": [
    "auth.password_changed"
   ]
  },
  {
   "id": "account.set_pin",
   "ui": "Settings > Account > Change PIN",
   "call": "account.set_pin",
   "params": {
    "password": "${PASSWORD}",
    "pin": "${PIN2}",
    "recovery_key": "${RK}"
   },
   "set": {
    "PIN": "${PIN2}"
   },
   "audit": [
    "auth.pin_changed"
   ]
  },
  {
   "id": "account.new_recovery_key",
   "ui": "Settings > Account > New recovery key",
   "call": "account.new_recovery_key",
   "params": {
    "password": "${PASSWORD}",
    "pin": "${PIN}"
   },
   "expect": {
    "has": [
     "recovery_key"
    ]
   },
   "save": {
    "RK": "recovery_key"
   },
   "audit": [
    "auth.recovery_key_rotated"
   ]
  },
  {
   "id": "auth.forgot_password",
   "ui": "Sign-in: Forgot password (PIN + recovery key)",
   "call": "auth.forgot_password",
   "params": {
    "pin": "${PIN}",
    "recovery_key": "${RK}",
    "new_password": "${PW3}"
   },
   "set": {
    "PASSWORD": "${PW3}"
   },
   "expect": {
    "has": [
     "recovery_key"
    ]
   },
   "save": {
    "RK": "recovery_key"
   },
   "pre": "sign_out",
   "audit": [
    "auth.password_reset"
   ]
  },
  {
   "id": "auth.sign_in_after_reset",
   "ui": "Sign in with the reset password",
   "call": "auth.sign_in",
   "params": {
    "username": "tester10",
    "password": "${PASSWORD}"
   }
  },
  {
   "id": "posture.run",
   "ui": "Settings > Account > Security posture",
   "call": "posture.run",
   "expect": {
    "len_ge": {
     "$len": 5
    }
   }
  },
  {
   "id": "posture.fix_unknown",
   "ui": "Posture > Fix (unknown action)",
   "call": "posture.fix",
   "params": {
    "action": "nope"
   },
   "expect": {
    "error_code": "invalid_request"
   },
   "stepup": "security_settings"
  },
  {
   "id": "posture.fix_verify_log",
   "ui": "Posture > Verify log",
   "call": "posture.fix",
   "params": {
    "action": "verify_log"
   },
   "expect": {
    "truthy": [
     "ok"
    ]
   },
   "stepup": "security_settings"
  },
  {
   "id": "settings.describe",
   "ui": "Settings (any section)",
   "call": "settings.describe",
   "expect": {
    "has": [
     "groups",
     "settings"
    ]
   }
  },
  {
   "id": "settings.classify_tighten",
   "ui": "Settings: change a value (tighten/loosen decision)",
   "call": "settings.classify",
   "params": {
    "changes": {
     "ui.theme": "dark"
    }
   },
   "expect": {
    "has": [
     "loosening"
    ]
   }
  },
  {
   "id": "settings.apply_theme",
   "ui": "Settings > Appearance: theme card",
   "call": "settings.apply",
   "params": {
    "changes": {
     "ui.theme": "ocean",
     "ui.background": "waves"
    }
   },
   "audit": [
    "settings.changed"
   ]
  },
  {
   "id": "settings.apply_bad",
   "ui": "Settings: invalid value rejected",
   "call": "settings.apply",
   "params": {
    "changes": {
     "ui.theme": "neon-pink"
    }
   },
   "expect": {
    "error_code": "invalid_request"
   }
  },
  {
   "id": "settings.apply_unknown",
   "ui": "Settings: unknown key rejected",
   "call": "settings.apply",
   "params": {
    "changes": {
     "nope.nothing": 1
    }
   },
   "expect": {
    "error_code": "invalid_request"
   }
  },
  {
   "id": "settings.begin_loosen",
   "ui": "Loosening dialog (10 s wait)",
   "call": "settings.begin_loosen",
   "params": {
    "changes": {
     "web.allowlist": [
      "example.org"
     ]
    }
   },
   "expect": {
    "has": [
     "token"
    ]
   }
  },
  {
   "id": "settings.loosen_needs_password",
   "ui": "Loosening without password/token is refused",
   "call": "settings.apply",
   "params": {
    "changes": {
     "web.allowlist": [
      "example.org"
     ]
    }
   },
   "expect": {
    "error_code": "password_required"
   }
  },
  {
   "id": "settings.history",
   "ui": "Settings > Rules > history",
   "call": "settings.history",
   "expect": {
    "len_ge": {
     "$len": 1
    }
   }
  },
  {
   "id": "settings.profile_preview",
   "ui": "Settings > Autonomy > profile preview",
   "call": "settings.profile_preview",
   "params": {
    "profile": "cautious"
   },
   "expect": {
    "has": [
     "changes"
    ]
   }
  },
  {
   "id": "settings.rules_plain",
   "ui": "Settings > Rules & Safety (plain language)",
   "call": "settings.rules_plain",
   "expect": {
    "has": [
     "rules"
    ]
   }
  },
  {
   "id": "ui.open_link_screen",
   "ui": "Notification / link click opens a screen",
   "call": "ui.open_link",
   "params": {
    "url": "personalagent://approvals"
   },
   "expect": {
    "eq": {
     "screen": "approvals"
    }
   }
  },
  {
   "id": "ui.open_link_cannot_change_settings",
   "ui": "Links can only open screens (never change settings)",
   "call": "ui.open_link",
   "params": {
    "url": "personalagent://settings?ui.theme=dark&security.auto_lock_minutes=999"
   },
   "expect": {
    "eq": {
     "screen": "settings"
    }
   },
   "audit": [
    "ui.link_params_ignored"
   ]
  },
  {
   "id": "ui.open_link_unknown",
   "ui": "Unknown link screen is rejected",
   "call": "ui.open_link",
   "params": {
    "url": "personalagent://format-disk"
   },
   "expect": {
    "eq": {
     "screen": "home"
    }
   },
   "audit": [
    "ui.link_rejected"
   ]
  },
  {
   "id": "home.summary",
   "ui": "Home",
   "call": "home.summary",
   "expect": {
    "has": [
     "events",
     "budget"
    ]
   }
  },
  {
   "id": "home.dismiss",
   "ui": "Home > Updates > Dismiss",
   "call": "home.dismiss",
   "params": {
    "id": "evt-does-not-exist"
   }
  },
  {
   "id": "notifications.list",
   "ui": "Notifications",
   "call": "notifications.list"
  },
  {
   "id": "notifications.mark_read",
   "ui": "Notifications > Mark read",
   "call": "notifications.mark_read",
   "params": {}
  },
  {
   "id": "llm.models_empty",
   "ui": "Settings > AI Model",
   "call": "llm.models"
  },
  {
   "id": "llm.add_mock",
   "ui": "AI Model > Add model (dev mock)",
   "call": "llm.add",
   "params": {
    "model": {
     "provider": "dev_mock",
     "name": "mock"
    }
   },
   "expect": {
    "has": [
     "id"
    ]
   },
   "save": {
    "MOCK": "id"
   },
   "audit": [
    "model.added"
   ]
  },
  {
   "id": "llm.test_mock",
   "ui": "AI Model > Test model",
   "call": "llm.test",
   "params": {
    "model_id": "${MOCK}"
   },
   "expect": {
    "has": [
     "checks"
    ]
   },
   "audit": [
    "model.tested"
   ]
  },
  {
   "id": "llm.update_params",
   "ui": "AI Model > a model's 'Adjust' (context length, temperature)",
   "call": "llm.update",
   "params": {
    "model_id": "${MOCK}",
    "context_length": 16384,
    "temperature": 0.3
   },
   "expect": {
    "has": [
     "context_length",
     "temperature"
    ]
   }
  },
  {
   "id": "llm.update_params_reset",
   "ui": "AI Model > Adjust > Use defaults",
   "call": "llm.update",
   "params": {
    "model_id": "${MOCK}",
    "context_length": null,
    "temperature": null
   },
   "expect": {
    "has": [
     "context_from"
    ]
   }
  },
  {
   "id": "llm.set_role",
   "ui": "AI Model > default chat model",
   "call": "llm.set_role",
   "params": {
    "role": "standard",
    "model_id": "${MOCK}"
   },
   "audit": [
    "settings.changed"
   ]
  },
  {
   "id": "llm.add_second",
   "ui": "AI Model > Add another model",
   "call": "llm.add",
   "params": {
    "model": {
     "provider": "dev_mock",
     "name": "mock2"
    }
   },
   "save": {
    "MOCK2": "id"
   }
  },
  {
   "id": "llm.remove",
   "ui": "AI Model > Remove model",
   "call": "llm.remove",
   "params": {
    "model_id": "${MOCK2}"
   }
  },
  {
   "id": "llm.remote_needs_password",
   "ui": "AI Model > remote endpoint needs password",
   "call": "llm.add",
   "params": {
    "model": {
     "provider": "openai",
     "name": "remote",
     "endpoint": "http://203.0.113.9:8000/v1",
     "model_name": "x"
    }
   },
   "expect": {
    "error_code": "password_required"
   }
  },
  {
   "id": "llm.discover_ollama",
   "ui": "AI Model > Ollama > Discover",
   "call": "llm.discover",
   "params": {
    "provider": "ollama",
    "endpoint": "http://127.0.0.1:11434"
   },
   "requires": "ollama",
   "expect": {
    "has": [
     "models"
    ]
   }
  },
  {
   "id": "llm.inspect_ollama",
   "ui": "AI Model > Ollama > pick a discovered model (type is detected)",
   "call": "llm.inspect",
   "params": {
    "provider": "ollama",
    "endpoint": "http://127.0.0.1:11434",
    "model_name": "gemma4:latest"
   },
   "requires": "ollama",
   "expect": {
    "has": [
     "kind"
    ]
   }
  },
  {
   "id": "web.test_search_not_set_up",
   "ui": "Settings > Connectors > Web > Test web search (no provider yet)",
   "call": "web.test_search",
   "params": {},
   "expect": {
    "error_code": "needs_setup"
   }
  },
  {
   "id": "voice.no_stt",
   "ui": "Chat > mic with no STT model",
   "call": "voice.transcribe",
   "params": {
    "mime": "audio/webm"
   },
   "expect": {
    "error_code": "invalid_request"
   }
  },
  {
   "id": "chat.create",
   "ui": "Chat > New chat",
   "call": "chat.create",
   "expect": {
    "has": [
     "id"
    ]
   },
   "save": {
    "CHAT": "id"
   }
  },
  {
   "id": "localfiles.grant",
   "ui": "Chat > paperclip: attach a file from this PC",
   "call": "localfiles.grant",
   "params": {
    "chat_id": "${CHAT}",
    "path": "${TMP}/sales.csv"
   },
   "expect": {
    "has": [
     "id",
     "name",
     "kind"
    ],
    "eq": {
     "kind": "table",
     "name": "sales.csv"
    }
   },
   "save": {
    "LF": "id"
   },
   "audit": [
    "localfile.granted"
   ]
  },
  {
   "id": "localfiles.grant_blocked",
   "ui": "Chat > attach: unsupported file type",
   "call": "localfiles.grant",
   "params": {
    "chat_id": "${CHAT}",
    "path": "${TMP}/nope.exe"
   },
   "expect": {
    "error_code": "not_found"
   }
  },
  {
   "id": "localfiles.list",
   "ui": "Chat: attached-file chips",
   "call": "localfiles.list",
   "params": {
    "chat_id": "${CHAT}"
   },
   "expect": {
    "len_ge": {
     "$len": 1
    }
   }
  },
  {
   "id": "localfiles.folder_info",
   "ui": "Chat > folder button: approval dialog shows counts",
   "call": "localfiles.folder_info",
   "params": {
    "path": "${TMP}"
   },
   "expect": {
    "has": [
     "files",
     "subfolders",
     "subfolder_names"
    ],
    "eq": {
     "subfolders": 2
    }
   }
  },
  {
   "id": "localfiles.grant_folder_subfolders_unconfirmed",
   "ui": "Folder dialog: subfolders ticked without confirmation",
   "call": "localfiles.grant_folder",
   "params": {
    "chat_id": "${CHAT}",
    "path": "${TMP}",
    "include_subfolders": true,
    "confirm_subfolders": false
   },
   "expect": {
    "error_code": "subfolders_need_approval"
   }
  },
  {
   "id": "localfiles.grant_folder",
   "ui": "Chat > folder button > Share folder (without subfolders)",
   "call": "localfiles.grant_folder",
   "params": {
    "chat_id": "${CHAT}",
    "path": "${TMP}",
    "include_subfolders": false,
    "confirm_subfolders": false
   },
   "expect": {
    "has": [
     "id",
     "scope"
    ],
    "eq": {
     "scope": "folder",
     "recursive": false,
     "expired": false
    }
   },
   "save": {
    "LFD": "id"
   },
   "audit": [
    "localfile.folder_granted"
   ]
  },
  {
   "id": "localfiles.grant_folder_drive_root",
   "ui": "Folder dialog: a whole drive is refused",
   "call": "localfiles.grant_folder",
   "params": {
    "chat_id": "${CHAT}",
    "path": "C:\\\\",
    "include_subfolders": false,
    "confirm_subfolders": false
   },
   "expect": {
    "error_code": "policy_denied"
   }
  },
  {
   "id": "localfiles.requests",
   "ui": "Chat: cards 'assistant wants to read a subfolder'",
   "call": "localfiles.requests",
   "params": {
    "chat_id": "${CHAT}"
   },
   "expect": {
    "len_ge": {
     "$len": 0
    }
   }
  },
  {
   "id": "localfiles.allow_subfolders_unconfirmed",
   "ui": "Subfolder card: Allow without confirmation",
   "call": "localfiles.allow_subfolders",
   "params": {
    "grant_id": "${LFD}",
    "confirm": false
   },
   "expect": {
    "error_code": "subfolders_need_approval"
   }
  },
  {
   "id": "localfiles.allow_subfolders",
   "ui": "Subfolder card > Allow subfolders",
   "call": "localfiles.allow_subfolders",
   "params": {
    "grant_id": "${LFD}",
    "confirm": true
   },
